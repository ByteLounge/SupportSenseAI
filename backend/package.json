{
  "name": "supportsense-backend",
  "version": "1.0.0",
  "description": "SupportSense AI Core Express REST Backend API",
  "main": "server.js",
  "scripts": {
    "start": "node server.js",
    "dev": "nodemon server.js",
    "test": "jest --detectOpenHandles"
  },
  "dependencies": {
    "bcryptjs": "^2.4.3",
    "cors": "^2.8.5",
    "dotenv": "^16.4.5",
    "express": "^4.19.2",
    "express-rate-limit": "^7.2.0",
    "helmet": "^7.1.0",
    "jsonwebtoken": "^9.0.2",
    "pg": "^8.11.5",
    "swagger-ui-express": "^5.0.0"
  },
  "devDependencies": {
    "jest": "^29.7.0",
    "nodemon": "^3.1.0",
    "supertest": "^6.3.4"
  },
  "jest": {
    "testEnvironment": "node",
    "rootDir": "..",
    "roots": [
      "<rootDir>/tests"
    ],
    "moduleDirectories": [
      "node_modules",
      "<rootDir>/backend/node_modules"
    ],
    "testMatch": [
      "**/*.test.js"
    ]
  }
}
