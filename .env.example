# Environment Variables Blueprint for SupportSense AI

# Node.js Express Backend
PORT=5000
NODE_ENV=production
JWT_SECRET=supportsense_enterprise_prod_secret_2026
JWT_EXPIRES_IN=1h

# PostgreSQL Relational Database (Supabase Cloud or Local Docker)
# Option A: Supabase Connection Pooler (Recommended for Render / Production, Port 6543)
# DATABASE_URL=postgresql://postgres.[PROJECT-REF]:[YOUR-PASSWORD]@aws-0-[REGION].pooler.supabase.com:6543/postgres
# Option B: Supabase Direct Connection (Port 5432)
# DATABASE_URL=postgresql://postgres:[YOUR-PASSWORD]@db.[PROJECT-REF].supabase.co:5432/postgres
# DB_SSL=true

# Option C: Local PostgreSQL / Docker Container
DB_HOST=localhost
DB_PORT=5432
DB_NAME=supportsense_db
DB_USER=postgres
DB_PASSWORD=postgrespassword
DB_SSL=false

# FastAPI AI Microservice & Gemini LLM
AI_SERVICE_URL=http://localhost:8000
GEMINI_API_KEY=your_google_gemini_api_key_here
GEMINI_MODEL_NAME=gemini-1.5-flash
